# ==============================================================================
# ApexMatch Environment Configuration Template
# Copy this file to .env and provide your database credentials.
# Do NOT commit your actual .env file to source control.
# ==============================================================================

# PostgreSQL / Neon Connection Details
DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
DB_USERNAME=<YOUR_DATABASE_USERNAME>
DB_PASSWORD=<YOUR_DATABASE_PASSWORD>

# Alternative Spring Boot standard naming:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<YOUR_DATABASE_USERNAME>
# SPRING_DATASOURCE_PASSWORD=<YOUR_DATABASE_PASSWORD>
